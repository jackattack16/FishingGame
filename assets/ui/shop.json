              "font": "small",
              "text_align": "left",
              "horizontal_text_align": "none",
              "vertical_text_align": "none",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.muted"
              }
            }
          ]
        },
        {
          "type": "spacer",
          "width": 0,
          "height": {
            "bind": "layout.body_gap",
            "unit": "px"
          }
        },
        {
          "type": "container",
          "id": "catch_body",
