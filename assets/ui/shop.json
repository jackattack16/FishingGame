                          "bg_color": {
                            "bind": "colors.transparent"
                          },
                          "text_color": {
                            "bind": "colors.muted"
                          }
                        },
                        {
                          "type": "textbox",
                          "width": 100,
                          "height": {
                            "bind": "title_height",
