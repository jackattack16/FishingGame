                  "display_direction": "column",
                  "spacing": "together",
                  "bg_color": {
                    "bind": "colors.card"
                  },
                  "text_color": {
                    "bind": "colors.text"
                  },
                  "radius": {
                    "bind": "layout.radius"
                  },
                  "elements": [
