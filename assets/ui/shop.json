                      "text_align": "center",
                      "horizontal_text_align": "none",
                      "vertical_text_align": "none",
                      "bg_color": {
                        "bind": "colors.transparent"
                      },
                      "text_color": {
                        "bind": "colors.muted"
                      }
                    }
                  ]
                },
                {
                  "use": "catch_card",
                  "repeat": "catches"
                }
              ]
            },
            {
              "type": "spacer",
              "width": 0,
              "height": {
                "bind": "layout.card_gap",
                "unit": "px"
