          "height": {
            "bind": "layout.body_height",
            "unit": "px"
          },
          "display_direction": "column",
          "spacing": "together",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
