                          "vertical_text_align": "none",
                          "bg_color": {
                            "bind": "colors.transparent"
                          },
                          "text_color": {
                            "bind": "colors.accent"
                          }
                        }
                      ]
                    },
                    {
                      "type": "button",
                      "id": "sell",
                      "width": 27,
                      "height": 100,
                      "text": "Sell raw catch",
                      "on_click": "sell_catch",
                      "has_on_click": {
                        "bind": "has_catch"
                      },
                      "font": "body",
                      "bg_color": {
                        "bind": "sell_color"
                      },
                      "text_color": {
                        "bind": "sell_text_color"
                      },
                      "radius": {
                        "bind": "layout.button_radius"
                      },
                      "border_color": {
                        "bind": "colors.accent"
                      },
                      "border_width": {
                        "bind": "layout.button_border"
                      }
                    },
                    {
                      "type": "button",
                      "id": "refine",
                      "width": 40,
                      "height": 100,
                      "text": "Refine / orders soon",
                      "on_click": "noop",
                      "has_on_click": false,
                      "font": "body",
                      "bg_color": {
                        "bind": "colors.disabled"
                      },
                      "text_color": {
                        "bind": "colors.muted"
                      },
                      "radius": {
                        "bind": "layout.button_radius"
                      },
                      "border_color": {
                        "bind": "colors.accent"
                      },
                      "border_width": {
                        "bind": "layout.button_border"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "id": "item_body",
          "when": {
            "bind": "item_tab"
          },
          "width": 100,
          "height": {
            "bind": "layout.body_height",
            "unit": "px"
          },
          "display_direction": "row",
          "spacing": "together",
          "wrap": true,
          "gap": {
            "bind": "card_gap_percent"
          },
          "wrap_gap": {
            "bind": "card_wrap_gap_percent"
          },
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "use": "item_card",
              "repeat": "items"
            }
          ]
        },
        {
          "type": "spacer",
          "width": 0,
          "height": {
            "bind": "layout.body_gap",
            "unit": "px"
          }
        },
        {
          "type": "container",
          "id": "message",
          "width": 100,
          "height": {
            "bind": "layout.message_height",
            "unit": "px"
          },
          "display_direction": "column",
          "spacing": "together",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "type": "textbox",
              "width": 100,
              "height": 100,
              "text": "${message}$",
              "variables": {
                "message": {
                  "bind": "shop.message"
                }
              },
              "font": "body",
              "text_align": "left",
              "horizontal_text_align": "none",
              "vertical_text_align": "none",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.accent"
              }
            }
          ]
        },
        {
          "type": "spacer",
          "width": 0,
          "height": {
            "bind": "layout.footer_gap",
            "unit": "px"
          }
        },
        {
          "type": "container",
          "id": "footer",
          "width": 100,
          "height": {
            "bind": "layout.footer_height",
            "unit": "px"
          },
          "display_direction": "row",
          "spacing": "between",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "type": "textbox",
              "width": 60,
              "height": 100,
              "text": "1-7: browse / Enter: sell, then continue",
              "font": "small",
              "text_align": "left",
              "horizontal_text_align": "none",
              "vertical_text_align": "center",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.muted"
              }
            },
            {
              "type": "button",
              "id": "next",
              "width": 28,
              "height": 100,
              "text": {
                "bind": "next_text"
              },
              "on_click": "next_round",
              "has_on_click": true,
              "font": "body",
              "bg_color": {
                "bind": "colors.button"
              },
              "text_color": {
                "bind": "colors.text"
              },
              "radius": {
                "bind": "layout.button_radius"
              },
              "border_color": {
                "bind": "colors.accent"
              },
              "border_width": {
                "bind": "layout.button_border"
              }
            }
          ]
        }
      ]
    }
  ]
}
