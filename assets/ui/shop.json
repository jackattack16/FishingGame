                      "height": 100,
                      "display_direction": "column",
                      "spacing": "together",
                      "bg_color": {
                        "bind": "colors.transparent"
                      },
                      "text_color": {
                        "bind": "colors.text"
                      },
                      "radius": {
                        "bind": "layout.radius"
                      },
                      "elements": [
                        {
                          "type": "textbox",
