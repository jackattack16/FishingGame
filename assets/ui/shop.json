                  "text_align": "left",
                  "horizontal_text_align": "none",
                  "vertical_text_align": "none",
                  "bg_color": {
                    "bind": "colors.transparent"
                  },
                  "text_color": {
                    "bind": "colors.muted"
                  }
                },
                {
                  "type": "textbox",
                  "width": 100,
                  "height": {
                    "bind": "statistic_height",
                    "unit": "px"
                  },
                  "text": "${value}$",
                  "variables": {
                    "value": {
                      "bind": "cash"
                    }
                  },
                  "font": "heading",
                  "text_align": "left",
                  "horizontal_text_align": "none",
                  "vertical_text_align": "none",
                  "bg_color": {
                    "bind": "colors.transparent"
                  },
                  "text_color": {
                    "bind": "colors.accent"
                  }
                }
              ]
            },
            {
              "type": "container",
              "width": 32,
              "height": 100,
              "display_direction": "column",
              "spacing": "together",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.text"
              },
              "radius": {
                "bind": "layout.radius"
              },
              "elements": [
                {
                  "type": "textbox",
                  "width": 100,
                  "height": {
                    "bind": "small_height",
                    "unit": "px"
                  },
                  "text": "POND STOCK",
                  "font": "small",
                  "text_align": "left",
                  "horizontal_text_align": "none",
                  "vertical_text_align": "none",
                  "bg_color": {
                    "bind": "colors.transparent"
                  },
                  "text_color": {
                    "bind": "colors.muted"
                  }
                },
                {
                  "type": "textbox",
                  "width": 100,
                  "height": {
                    "bind": "statistic_height",
                    "unit": "px"
                  },
                  "text": "${value}$",
                  "variables": {
                    "value": {
                      "bind": "pond_stock"
                    }
                  },
                  "font": "body",
                  "text_align": "left",
                  "horizontal_text_align": "none",
                  "vertical_text_align": "none",
                  "bg_color": {
                    "bind": "colors.transparent"
                  },
                  "text_color": {
                    "bind": "colors.text"
                  }
                }
              ]
            },
            {
              "type": "container",
              "width": 32,
              "height": 100,
              "display_direction": "column",
              "spacing": "together",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.text"
              },
              "radius": {
                "bind": "layout.radius"
              },
              "elements": [
                {
                  "type": "textbox",
                  "width": 100,
                  "height": {
                    "bind": "small_height",
                    "unit": "px"
                  },
                  "text": "CATCH VALUE",
                  "font": "small",
                  "text_align": "left",
                  "horizontal_text_align": "none",
                  "vertical_text_align": "none",
                  "bg_color": {
                    "bind": "colors.transparent"
                  },
                  "text_color": {
                    "bind": "colors.muted"
                  }
                },
                {
                  "type": "textbox",
                  "width": 100,
                  "height": {
                    "bind": "statistic_height",
                    "unit": "px"
                  },
                  "text": "${value}$",
                  "variables": {
                    "value": {
                      "bind": "catch_value"
                    }
                  },
                  "font": "heading",
                  "text_align": "left",
                  "horizontal_text_align": "none",
                  "vertical_text_align": "none",
                  "bg_color": {
                    "bind": "colors.transparent"
                  },
                  "text_color": {
                    "bind": "colors.text"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "spacer",
          "width": 0,
          "height": {
            "bind": "layout.section_gap",
            "unit": "px"
          }
        },
        {
          "type": "container",
          "id": "tabs",
          "width": 100,
          "height": {
            "bind": "layout.tabs_height",
            "unit": "px"
          },
          "display_direction": "row",
          "spacing": "between",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "use": "tab",
              "repeat": "shop.categories"
            }
          ]
        },
        {
          "type": "spacer",
          "width": 0,
          "height": {
            "bind": "layout.subtitle_gap",
            "unit": "px"
