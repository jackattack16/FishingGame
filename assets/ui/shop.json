                      "bg_color": {
                        "bind": "colors.transparent"
                      },
                      "text_color": {
                        "bind": "colors.text"
                      }
                    },
                    {
                      "type": "spacer",
                      "width": 0,
                      "height": {
                        "bind": "layout.item_gap",
                        "unit": "px"
                      }
                    },
                    {
                      "type": "textbox",
                      "width": 100,
                      "height": {
                        "bind": "body_font_height",
