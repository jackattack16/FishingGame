{
  "templates": {
    "catch_card": {
      "type": "container",
      "width": {
        "bind": "catch_card_width"
      },
      "height": 100,
      "padding": {
        "bind": "layout.catch_padding"
      },
      "display_direction": "column",
      "spacing": "together",
      "bg_color": {
        "bind": "colors.card"
      },
      "text_color": {
        "bind": "colors.text"
      },
      "radius": {
        "bind": "layout.radius"
      },
      "elements": [
        {
          "type": "container",
          "width": 100,
          "height": {
            "bind": "layout.catch_sprite_size",
            "unit": "px"
          },
          "display_direction": "row",
          "spacing": "evenly",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "type": "image",
              "width": {
                "bind": "layout.catch_sprite_size",
                "unit": "px"
              },
              "height": 100,
              "image": {
                "bind": "fish_image"
              },
              "quad": {
                "bind": "catch_quad"
              }
            }
          ]
        },
        {
          "type": "textbox",
          "width": 100,
          "height": {
            "bind": "layout.catch_name_height",
            "unit": "px"
          },
          "text": {
            "bind": "item.name"
          },
          "font": "body",
          "text_align": "left",
          "horizontal_text_align": "none",
          "vertical_text_align": "none",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          }
        },
        {
          "type": "textbox",
          "width": 100,
          "height": {
            "bind": "layout.catch_stats_height",
            "unit": "px"
          },
          "text": {
            "bind": "catch_stats"
          },
          "font": "small",
          "text_align": "left",
          "horizontal_text_align": "none",
          "vertical_text_align": "none",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.muted"
          }
        },
        {
          "type": "textbox",
          "width": 100,
          "height": {
            "bind": "layout.catch_price_height",
            "unit": "px"
          },
          "text": {
            "bind": "catch_price"
          },
          "font": "heading",
          "text_align": "left",
          "horizontal_text_align": "none",
          "vertical_text_align": "none",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.accent"
          }
        }
      ]
    },
    "item_card": {
      "type": "container",
      "width": {
        "bind": "item_card_width"
      },
      "height": {
        "bind": "layout.card_height",
        "unit": "px"
      },
      "padding": {
        "bind": "layout.card_padding"
      },
      "display_direction": "column",
      "spacing": "together",
      "bg_color": {
        "bind": "colors.card"
      },
      "text_color": {
        "bind": "colors.text"
      },
      "radius": {
        "bind": "layout.radius"
      },
      "elements": [
        {
          "type": "container",
          "width": 100,
          "height": {
            "bind": "layout.item_title_height",
            "unit": "px"
          },
          "display_direction": "row",
          "spacing": "between",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "type": "textbox",
              "width": {
                "bind": "item_title_width"
              },
              "height": 100,
              "text": {
                "bind": "item.name"
              },
              "font": "heading",
              "text_align": "left",
              "horizontal_text_align": "none",
              "vertical_text_align": "none",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.text"
              }
            },
            {
              "type": "image",
              "when": {
                "bind": "item_has_sprite"
              },
              "width": {
                "bind": "layout.item_sprite_size",
                "unit": "px"
              },
              "height": {
                "bind": "layout.item_sprite_size",
                "unit": "px"
              },
              "image": {
                "bind": "fish_image"
              },
              "quad": {
                "bind": "item_quad"
              }
            }
          ]
        },
        {
          "type": "textbox",
          "width": 100,
          "height": {
            "bind": "layout.description_height",
            "unit": "px"
          },
          "text": {
            "bind": "item.description"
          },
          "font": "small",
          "text_align": "left",
          "horizontal_text_align": "none",
          "vertical_text_align": "none",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.muted"
          }
        },
        {
          "type": "spacer",
          "width": 0,
          "height": {
            "bind": "layout.item_gap",
            "unit": "px"
          }
        },
        {
          "type": "textbox",
          "width": 100,
          "height": {
            "bind": "layout.owned_height",
            "unit": "px"
          },
          "text": {
            "bind": "owned_text"
          },
          "font": "small",
          "text_align": "left",
          "horizontal_text_align": "none",
          "vertical_text_align": "none",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.accent"
          }
        },
        {
          "type": "spacer",
          "width": 0,
          "height": {
            "bind": "layout.item_gap",
            "unit": "px"
          }
        },
        {
          "type": "container",
          "width": 100,
          "height": {
            "bind": "layout.action_height",
            "unit": "px"
          },
          "display_direction": "row",
          "spacing": "between",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "type": "textbox",
              "width": {
                "bind": "layout.price_width",
                "unit": "px"
              },
              "height": 100,
              "text": {
                "bind": "item_price"
              },
              "font": "body",
              "text_align": "left",
              "horizontal_text_align": "none",
              "vertical_text_align": "center",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.accent"
              }
            },
            {
              "type": "button",
              "id": {
                "bind": "item.id"
              },
              "width": {
                "bind": "layout.buy_width",
                "unit": "px"
              },
              "height": 100,
              "text": {
                "bind": "buy_text"
              },
              "on_click": "buy",
              "has_on_click": {
                "bind": "can_buy"
              },
              "font": "body",
              "bg_color": {
                "bind": "buy_color"
              },
              "text_color": {
                "bind": "buy_text_color"
              },
              "radius": {
                "bind": "layout.button_radius"
              },
              "border_color": {
                "bind": "colors.accent"
              },
              "border_width": {
                "bind": "layout.button_border"
              }
            }
          ]
        }
      ]
    },
    "tab": {
      "type": "button",
      "id": {
        "bind": "tab_id"
      },
      "width": {
        "bind": "tab_width"
      },
      "height": 100,
      "text": {
        "bind": "item.name"
      },
      "on_click": "select_tab",
      "has_on_click": true,
      "font": "body",
      "bg_color": {
        "bind": "tab_color"
      },
      "text_color": {
        "bind": "tab_text_color"
      },
      "radius": {
        "bind": "layout.button_radius"
      },
      "border_color": {
        "bind": "colors.accent"
      },
      "border_width": {
        "bind": "layout.button_border"
      }
    }
  },
  "window": [
    {
      "type": "container",
      "id": "shop_root",
      "x": {
        "bind": "viewport.x"
      },
      "y": {
        "bind": "viewport.y"
      },
      "width": {
        "bind": "root_width"
      },
      "height": {
        "bind": "root_height"
      },
      "x_padding": {
        "bind": "layout.padding_x"
      },
      "y_padding": {
        "bind": "layout.padding_y"
      },
      "display_direction": "column",
      "spacing": "together",
      "bg_color": {
        "bind": "colors.panel"
      },
      "text_color": {
        "bind": "colors.text"
      },
      "radius": {
        "bind": "layout.radius"
      },
      "elements": [
        {
          "type": "container",
          "id": "header",
          "width": 100,
          "height": {
            "bind": "layout.header_height",
            "unit": "px"
          },
          "display_direction": "row",
          "spacing": "between",
          "bg_color": {
            "bind": "colors.transparent"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "type": "textbox",
              "width": 60,
              "height": 100,
              "text": "Hatchery shop",
              "font": "title",
              "text_align": "left",
              "horizontal_text_align": "none",
              "vertical_text_align": "none",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.text"
              }
            },
            {
              "type": "textbox",
              "width": 38,
              "height": 100,
              "text": "BETWEEN ROUNDS  /  ROUND ${round}$",
              "variables": {
                "round": {
                  "bind": "state.round"
                }
              },
              "font": "small",
              "text_align": "right",
              "horizontal_text_align": "none",
              "vertical_text_align": "center",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.muted"
              }
            }
          ]
        },
        {
          "type": "spacer",
          "width": 0,
          "height": {
            "bind": "layout.section_gap",
            "unit": "px"
          }
        },
        {
          "type": "container",
          "id": "summary",
          "width": 100,
          "height": {
            "bind": "layout.summary_height",
            "unit": "px"
          },
          "padding": {
            "bind": "layout.card_padding"
          },
          "display_direction": "row",
          "spacing": "between",
          "bg_color": {
            "bind": "colors.card"
          },
          "text_color": {
            "bind": "colors.text"
          },
          "radius": {
            "bind": "layout.radius"
          },
          "elements": [
            {
              "type": "container",
              "width": 32,
              "height": 100,
              "display_direction": "column",
              "spacing": "together",
              "bg_color": {
                "bind": "colors.transparent"
              },
              "text_color": {
                "bind": "colors.text"
              },
              "radius": {
                "bind": "layout.radius"
              },
