{
  "window": [
    {
      "type": "container",
      "id": "left_bar",
      "x": 0,
      "y": 0,
      "width": "10%",
      "height": "85%",
      "x_padding": 10,
      "y_padding": 10,
      "display_direction": "column",
      "spacing": "together",
      "wrap": true,
      "gap": 2,
      "bg_color": [0, 0, 0, 0.5],
      "elements": [
        {
          "type": "textbox",
          "width": "100%",
          "text": "Money: $${money}$",
          "variables": {
            "money": {
              "bind": "money"
            }
          },
          "bg_color": [0, 0, 0, 0],
          "text_color": [1, 1, 1]
        },
        {
          "type": "textbox",
          "width": "100%",
          "text": "Bait: ${bait}$",
          "variables": {
            "bait": {
              "bind": "bait"
            }
          },
          "bg_color": [0, 0, 0, 0],
          "text_color": [1, 1, 1]
        },
        {
          "type": "textbox",
          "width": "100%",
          "y_padding": 5,
          "text": "Press y to save catch",
          "bg_color": [0, 0, 0, 0],
          "text_color": [1, 1, 1]
        },
        {
          "type": "textbox",
          "width": "100%",
          "y_padding": 5,
          "text": "Press n to release catch",
          "bg_color": [0, 0, 0, 0],
          "text_color": [1, 1, 1]
        }
      ]
    },
    {
      "type": "container",
      "id": "bottom_bar",
      "x": 0,
      "y": "85%",
      "width": "full",
      "height": "15%",
      "x_padding": 10,
      "y_padding": 10,
      "display_direction": "row",
      "spacing": "together",
      "wrap": true,
      "gap": 10,
      "bg_color": [0, 0, 0, 0.5],
      "elements": [
        {
          "type": "button",
          "id": "settings",
          "width": "10%",
          "height": "100%",
          "text": "Settings",
          "bg_color": [0.153, 0.153, 0.153]
        }
      ]
    }
  ]
}
